# 複製這個檔案成 .env 並填入真實值，.env 不會進版控
# 注意：Taskfile 是用 bash `source` 讀這個檔案的，值裡面有空格（例如 portgroup
# 名稱常見的 "VM Network"）一定要加引號，不然 source 會把它拆成多個指令執行；
# 建議用單引號，雙引號裡的 $ 跟反引號還是會被 bash 展開，單引號才是完全照字面
#
# 這些是 SSH 進虛擬化主機、搬檔案用的連線資訊，跟是不是 ESXi 無關（我們不透過
# 任何 vSphere API，純粹 SSH + scp + 本地檔案系統工具），所以命名不綁 ESXi。
HYPERVISOR_HOSTNAME=192.168.1.10
HYPERVISOR_USERNAME=root
HYPERVISOR_PASSWORD=changeme
HYPERVISOR_DATASTORE=datastore1
HYPERVISOR_NETWORK='VM Network'

# 透過 SSH 連本機 Windows（WSL2 的場景）用，見 inventory/windows.ini——這個
# 帳號要是 Windows 本機的系統管理員群組成員，才能改防火牆規則之類的設定；
# WINDOWS_PASSWORD 只在第一次連線（SSH 金鑰還沒被部署到 Windows 的
# administrators_authorized_keys 之前）當備援用，之後都是金鑰認證
WINDOWS_USERNAME=changeme
WINDOWS_PASSWORD=changeme

# 無條件必填，不是表單選了才填——harbor.yml 裝機前就無條件渲染進 ISO，
# 不管最後 VM 開機後跑 bootstrap-services 要不要真的裝 Harbor 都要先填好
# （要不要裝 Harbor 是開機後才問的，build 這個當下沒有旗標可以判斷要不要
# 檢查）。這兩個是 Harbor 的 admin 帳號密碼、內部 postgres 密碼——跟上面
# 幾個一樣是「人自己決定、人自己記得」的密碼，不是程式自動產生的隨機字串
# （Harbor 的 CA 私鑰、robot 拉取帳號的 secret 才是程式自動產生，那些存在
# VM 本機的 /opt/harbor/secrets/ 底下，不在這裡）。
HARBOR_ADMIN_PASSWORD=changeme
HARBOR_DB_PASSWORD=changeme
