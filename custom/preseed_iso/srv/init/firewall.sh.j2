#!/bin/bash
set -euo pipefail

# late_command（見 preseed.cfg.j2）本來也會在裝機階段嘗試套用這份 ufw 規則，
# 但實測發現 in-target ufw ... 在 d-i 安裝環境自己的 chroot 裡執行會悄悄
# 失效——ufw 開機後顯示 active，但規則數是 0，等於完全沒有防火牆在擋
# （fail-open），late_command 又是用 ; 串接、任何一步失敗都不會中止，所以
# 裝機過程完全看不出這個問題。這支腳本把同一份規則搬到這裡——late_command
# 寫了 podman-network.service/firewall.service/finalizer.service 三個 systemd
# unit，ConditionPathExists 各自指著 /srv/init/ 底下自己的檔案路徑（不是
# ConditionFirstBoot，單純檔案還在不在），彼此用 After=/Requires= 串成固定
# 順序：podman-network → firewall → finalizer（見 finalizer.sh 自己的說明）。
# VM 第一次真開機時依序自動跑完，裝機完就是完整防護狀態，不需要使用者手動
# 介入；這裡才是能安全直接呼叫 `ufw enable` 的地方（不是 d-i chroot，是真正
# 跑起來的系統，套用規則不會有風險）。
#
# 這支只負責套用 ufw 規則，不負責清理——清掉 /srv/init 的動作獨立成
# finalizer.sh，只有在這支真的成功（systemd 看到 exit code 0、
# firewall.service 變成 active）之後才會被排進去跑，失敗的話 finalizer
# 不會被觸發，/srv/init 原樣留著讓人修完再重跑。把「套用防火牆規則」跟
# 「事後清理」拆成兩支獨立的腳本，而不是像原來單支腳本那樣自己成功後自己
# 刪自己：這樣這支腳本的成功/失敗語意只跟 ufw 規則本身有沒有套用成功有關，
# 不會被一個跟防火牆邏輯無關的 rm 操作混在一起判斷。

if [ "$(id -u)" -ne 0 ]; then
  echo "錯誤：請用 sudo 執行這支程式（例如：sudo /srv/init/firewall.sh）" >&2
  exit 1
fi

# 跟 preseed.cfg.j2 原本 late_command 裡要套用的規則完全一樣：
# (1) WireGuard 自己的 UDP 監聽埠——只准實體 LAN 網段連進來（WireGuard 的
#     handshake 封包是從 peer 還沒加入隧道前的真實來源位址打過來的，不能
#     用 WireGuard 子網本身去限制，否則自己把隧道堵死）；
# (2) SSH port——只准 WireGuard peer 子網，跟 sshd 自己的 ListenAddress
#     鎖定是同一個不變量，ufw 只是再加一層；
# (3) chrony 的 123/udp——同樣只准 WireGuard peer 子網；
# (4) caddy-proxy 的對外埠——整台 VM 唯一的 HTTP(S) 入口，不管後面實際代理
#     了哪些服務（Harbor、RustFS 或以後加的任何東西），只需要開這一個洞，
#     新增服務不用回來改這支腳本。caddy-proxy 現在同時綁在兩個獨立的
#     WireGuard interface 上（見下面 REDIRECT 那段、debian.yml 兩套
#     WireGuard 身分的說明），所以這裡要各開一條：
#     - {{ wireguard_cluster_peer_subnet }}：cluster 的 peer（管理面存取、
#       以後的 k3s cluster 流量）。
#     - {{ wireguard_infrastructure_peer_subnet }}：infrastructure 的 peer
#       （不屬於任何單一 cluster、多個 cluster 共用的基礎設施，目前只有
#       Harbor）——這裡的存取邊界是「誰拿得到 infrastructure 的 peer 金鑰」
#       （見 /srv/network/infrastructure/ 底下的認領腳本），ufw/REDIRECT
#       這層只管埠通不通，管不到 Caddy 裡面是哪個 hostname/site，這是
#       刻意接受的邊界劃分，不是疏漏。
#     - {{ lan_subnet }}：這台 VM 以後要當 k3s host 用時，其他 server 通常
#       會跟它在同一個實體 LAN 網段，不一定會透過 WireGuard 連——目前還沒有
#       設計 agent-to-agent 或 server mesh 的連線方式，直接放行同網段是現階段
#       最簡單可行的做法。
#     放行的埠是 {{ caddy_proxy_internal_port }}，不是 client 端實際連的
#     {{ caddy_proxy_https_port }}——下面那段 nat REDIRECT 規則會把目標埠
#     443 的封包在到達 filter table 的 INPUT chain 之前，就先改寫成
#     {{ caddy_proxy_internal_port }}，這裡的 ufw allow 要放行的是改寫*之後*
#     INPUT chain 真正看到的那個埠，不然規則永遠比對不到、封包會被
#     default deny incoming 擋掉。
ufw default deny incoming
ufw default allow outgoing
ufw allow from {{ lan_subnet }} to any port {{ wireguard_cluster_listen_port }} proto udp
{% if is_infrastructure_host %}
ufw allow from {{ lan_subnet }} to any port {{ wireguard_infrastructure_listen_port }} proto udp
{% endif %}
ufw allow from {{ wireguard_cluster_peer_subnet }} to any port {{ vm_ssh_port }} proto tcp
ufw allow from {{ wireguard_cluster_peer_subnet }} to any port 123 proto udp
ufw allow from {{ wireguard_cluster_peer_subnet }} to any port {{ caddy_proxy_internal_port }} proto tcp
{% if is_infrastructure_host %}
ufw allow from {{ wireguard_infrastructure_peer_subnet }} to any port {{ caddy_proxy_internal_port }} proto tcp
{% endif %}
ufw allow from {{ lan_subnet }} to any port {{ caddy_proxy_internal_port }} proto tcp

# caddy-proxy 是 rootless 使用者，容器對外發布的埠（podman -p，實際在主機
# 這邊 bind 的是 podman 自己的 rootlessport 這支 unprivileged helper）沒辦法
# 直接綁 443 這種 <1024 的特權埠——這裡本來考慮放寬 net.ipv4.ip_unprivileged_
# port_start 這個系統層級的 sysctl，但那樣等於讓「所有」unprivileged 行程
# 都能 bind 443 以上的埠，範圍比真正需要的大。改成在這裡（root 身份，這支
# 腳本本來就是開機第一次用 root 跑的）用 nat table 的 REDIRECT，把「進到
# wg-cluster/wg-infrastructure 介面、目標埠 443」的封包在 kernel 層直接
# 改寫成 {{ caddy_proxy_internal_port }}——caddy-proxy 容器實際監聽、發布的
# 就是這個高位埠（見 caddy-proxy-install.yml），全程沒有任何 unprivileged
# 行程真的去 bind 特權埠，安全姿態跟 k3s 的 Traefik 一樣（Traefik pod 本身
# 也只監聽高位埠，80/443 轉發是 host 端用 root 身份的 kube-proxy/ServiceLB
# 處理掉的）。
#
# REDIRECT 這個 target 的行為是把封包的目的位址改寫成「封包進來那個介面
# 本身的位址」，不是 127.0.0.1——兩個介面各自的位址不一樣
# （{{ wireguard_cluster_vm_address }}、{{ wireguard_infrastructure_vm_address }}），
# 所以要各寫一條 REDIRECT 規則，不能只寫一條。這也代表 caddy-proxy 的
# podman -p 要同時明確綁這兩個位址（各自搭配
# {{ caddy_proxy_internal_port }}），不能只寫埠號監聽所有介面，否則改寫後
# 的目的位址對不上任何監聽中的 socket。
#
# 用 /etc/ufw/before.rules 加 *nat 區塊，不是直接呼叫 iptables：這支腳本
# 跑完之後呼叫的是 ufw（不是裸的 iptables），ufw 自己的規則來源只認它管理
# 的這幾個檔案（before.rules/after.rules/user.rules），裸 iptables 下的
# 規則不會被 ufw 自己的狀態追蹤到，重開機後 ufw 重新套用規則時也不會保留
# 任何沒寫進這些檔案裡的東西——*nat 區塊要放在 before.rules 最前面
# （iptables-restore 吃的是多個獨立的 table 區塊，*nat 放在既有的 *filter
# 區塊之前或之後都可以，只要自己是完整的 *nat ... COMMIT 區塊）。這支腳本
# 本身是一次性的（見開頭的說明），正常情況下不會重複執行，但保留下面這個
# grep 檢查是為了手動重跑測試時不會重複插入。
#
# 下面直接對 before.rules 做 grep/cat/mv，沒有先檢查這個檔案存不存在——
# 不是沒檢查的假設，是查過 ufw 套件自己的 postinst script 確認過的保證：
# postinst 在 configure 這個階段（也就是 pkgsel/include 裝 ufw 套件的那
# 一刻，早在這支腳本跑之前）用 ucf 把 /usr/share/ufw/iptables/before.rules
# 這個套件自帶的範本部署到 /etc/ufw/before.rules，跟有沒有執行過
# ufw enable、甚至有沒有執行過任何一次 ufw 指令完全無關，純粹是套件安裝
# 本身的副作用。這個檔案存在是 ufw 套件自己保證的事，不是這個專案的推測。
#
# 用 heredoc 組好整段內容、再跟原檔案一起接起來寫回去，不是把多行內容硬塞
# 進 sed 的單行 1i 插入指令——原來 sed -i '1i...\n...\n...' 這種寫法，內容
# 跟插入機制混在同一行，任何一個代入值（例如以後 REDIRECT 的目標位址）裡
# 出現跟 sed 自己的語法衝突的字元，就會讓整條指令解析出乎意料的結果；
# heredoc 讓內容單純是文字，插入機制只是單純的「接在前面」，兩者互不干擾。
if ! grep -q '^\*nat$' /etc/ufw/before.rules; then
  nat_block=$(cat <<'EOF'
*nat
:PREROUTING ACCEPT [0:0]
-A PREROUTING -i wg-cluster -p tcp --dport 443 -j REDIRECT --to-port {{ caddy_proxy_internal_port }}
{% if is_infrastructure_host %}
-A PREROUTING -i wg-infrastructure -p tcp --dport 443 -j REDIRECT --to-port {{ caddy_proxy_internal_port }}
{% endif %}
COMMIT
EOF
)
  before_rules_tmp="$(mktemp)"
  { printf '%s\n' "$nat_block"; cat /etc/ufw/before.rules; } >"$before_rules_tmp"
  mv "$before_rules_tmp" /etc/ufw/before.rules
fi

# EE image build（手寫 Containerfile → podman build，見 config.sh 的 ensure_ee_image）
# 用的 podman network（podman-network.sh 建好的那個，固定子網
# 10.90.0.0/24、固定 gateway 10.90.0.1——這兩個值改了要連 podman-network.sh/
# squid.sh 一起改）不再直接連外網：build container 只透過 squid（bootstrap/
# services/squid.sh 裝的正向代理，full bump，監聽在這個 network 自己的
# gateway 10.90.0.1:3128）出去，squid 自己依照 /etc/squid/allowed_domains.txt
# 的白名單決定放不放行哪個網域。
#
# 這代表 build container 要通過的只是「連到宿主機自己」這件事（目的地就是
# 10.90.0.1 這個本機位址），不是「轉送到外部網路」——走的是 ufw 一般的
# INPUT chain，不是 FORWARD chain，所以不需要像第一版那樣用 `ufw route
# allow` 開 DNS/443 的轉送例外，連帶的 DEFAULT_FORWARD_POLICY=DROP 問題
# （最早撞到的那個問題，當時討論過不能整條 FORWARD chain 開 ACCEPT，範圍
# 太大）也因此不再相關——host 自己收下這個封包就結束了，不會把它轉送到
# 任何地方。squid.sh 執行的時間點晚於這三個 systemd unit（squid 跟著
# 互動式的 bootstrap-services 表單跑，三個 unit 開機就自動跑完了），所以
# 這條規則套用的當下，squid 還沒啟動也沒關係——ufw 規則本身跟 squid 服務
# 有沒有在監聽是兩件獨立的事，規則先放著不影響。
ufw allow from 10.90.0.0/24 to 10.90.0.1 port 3128 proto tcp

ufw --force enable

echo "ufw 規則已套用："
ufw status verbose
