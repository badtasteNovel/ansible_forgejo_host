# caddy-proxy-install.yml 要用的值——裝機前在控制節點就全部知道，這裡整份
# 渲染好注入 ISO，caddy-proxy-install.yml 用 vars_files 讀這個檔案，不用自己
# 猜/寫死。這支無條件渲染（跟 harbor_runtime_vars.yml 現在一樣都是無條件渲染，
# 差別只在 caddy-proxy 本身是強制功能，harbor_runtime_vars.yml 渲染出來的
# 東西最後用不用得到要看 bootstrap-services 的決定）。
caddy_proxy_user: "{{ caddy_proxy_user }}"
caddy_proxy_home: "{{ caddy_proxy_home }}"
wireguard_cluster_vm_address: "{{ wireguard_cluster_vm_address }}"
wireguard_basic_vm_address: "{{ wireguard_basic_vm_address }}" # 只有 is_basic_host 是 true 才會真的被拿來多綁一個 -p，見下面那個欄位
is_basic_host: {{ is_basic_host | bool | lower }} # caddy-proxy 要不要多綁 wireguard_basic_vm_address 這個位址，看這台 VM 是不是 basic 的 host（見 debian.yml 兩套 WireGuard 身分的說明），不是每台 VM 都無條件綁兩個位址
